# --- Jev toxicity gate (OpenRouter Decisions API). Leave empty to disable the gate (not recommended). ---
OPENROUTER_API_KEY=

# --- Paper mode needs nothing else. Live mode only: ---
# Private key of the wallet that signs orders (NEVER commit this file with real values).
PM_PRIVATE_KEY=
# Address that holds your funds: for an email/Magic account this is your Polymarket "deposit" (proxy) address,
# for a browser-wallet account it is the Safe address shown on polymarket.com/settings.
PM_FUNDER=
# 1 = email/Magic (POLY_PROXY), 2 = browser wallet (GNOSIS_SAFE), 0 = plain EOA
PM_SIGNATURE_TYPE=1
# Total collateral (pUSD) the bot may lock in resting orders
PMBOT_CAPITAL=100
